TZ=Asia/Colombo
ARRVIEW_PORT=3223

# Only if ArrView runs behind a reverse proxy / Cloudflare: comma-separated proxy IPs or CIDRs,
# e.g. 172.16.0.0/12. Forwarded client IPs are ignored unless the direct peer is listed here.
ARRVIEW_TRUSTED_PROXIES=

# Optional. API keys are encrypted at rest by default using a key ArrView generates in
# the data volume (encryption.key). Set this only to supply your own key instead.
# Keep it stable: losing/changing it prevents encrypted credentials from being read.
# Generate one with: openssl rand -hex 32
ARRVIEW_ENCRYPTION_KEY=

# Optional: URL of a shared ArrView metadata service you run. Leave empty to use
# your own TMDB API key from Admin → TMDB Metadata.
ARRVIEW_METADATA_API_URL=

# Official shared metadata service host only:
ARRVIEW_SHARED_TMDB_BEARER_TOKEN=
ARRVIEW_FREE_METADATA_MONTHLY_LIMIT=1000
ARRVIEW_FREE_METADATA_HOURLY_LIMIT=120
