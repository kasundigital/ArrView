TZ=Asia/Colombo
ARRVIEW_PORT=3223

# Optional: enable API credential encryption at rest from System after setting this.
# Keep this value stable. Losing/changing it prevents encrypted credentials from being read.
# Generate an example key with: openssl rand -hex 32
ARRVIEW_ENCRYPTION_KEY=

# Optional override for the shared ArrView metadata service.
ARRVIEW_METADATA_API_URL=https://arrview.dashboards420.com/metadata-api.php

# Official shared metadata service host only:
ARRVIEW_SHARED_TMDB_BEARER_TOKEN=
ARRVIEW_FREE_METADATA_MONTHLY_LIMIT=1000
